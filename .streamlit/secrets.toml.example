# Copy into Streamlit Community Cloud → your app → Settings → Secrets
# (or save locally as .streamlit/secrets.toml — never commit the real file).

# Password for the sidebar "Researcher login" (deleting/exporting data, running experiments).
admin_password = "choose-a-long-password"

[storage]
# The Google Sheet that receives feedback and pilot responses.
# Share it (Editor) with the service account's client_email below.
sheet_url = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"

[gcp_service_account]
# Paste the fields of the service-account JSON key you downloaded from Google Cloud.
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "soundbridge@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
