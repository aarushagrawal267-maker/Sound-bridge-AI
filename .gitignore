# environments
.venv/
venv/
env/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# data (downloaded / derived; rebuilt by scripts/setup_all.py)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.part

# large or regenerable model artifacts (the trained encoder weights and fitted
# feature pipeline ARE committed so results are inspectable)
models/*.npy
models/kmeans.joblib
models/popularity_xgb.joblib

# personal feedback never leaves the user's machine
data/feedback/*
!data/feedback/.gitkeep

# misc
.DS_Store
Thumbs.db

# credentials: real values go in Streamlit secrets or environment variables, never in git
# (the committed .streamlit/secrets.toml.example holds placeholders only)
.streamlit/secrets.toml
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
client_secret*.json
*service-account*.json
*service_account*.json

# local data dumps (feedback and pilot responses can contain personal data)
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
